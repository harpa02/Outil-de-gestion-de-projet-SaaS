# Configuration AgencyOS
# Copier ce fichier en .env pour surcharger les valeurs par défaut.
# Aucune modification de code n'est nécessaire.

# Application
PORT=3000
NODE_ENV=production
JWT_SECRET=change-me-in-production

# MongoDB
# Exemple local/compose: mongodb://mongodb:27017/saas_pm
# Exemple replica set (Partie II): mongodb://mongo1:27017,mongo2:27017,mongo3:27017/saas_pm?replicaSet=rs0
MONGODB_URI=mongodb://mongodb:27017/saas_pm
